                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has brands array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('brands');",
                  "    pm.expect(json.brands).to.be.an('array');",
                  "});",
