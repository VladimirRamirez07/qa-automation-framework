      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Verify Login - Invalid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns error for invalid credentials', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.responseCode).to.equal(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/verifyLogin",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "invalid@test.com" },
                { "key": "password", "value": "wrongpass" }
              ]
            }
          }
        }
      ]
    }
  ]
}